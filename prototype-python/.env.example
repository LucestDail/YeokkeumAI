# --- LLM 게이트웨이 (벤더무관; OpenAI 호환 엔드포인트면 무엇이든) ---
# auto: 키 있으면 실호출, 없으면 오프라인 stub. openai_compat / stub 강제 가능.
LLM_PROVIDER=auto
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=deepseek/deepseek-chat
LLM_API_KEY=
# 예) 사내 게이트웨이/국산 K-AI: LLM_BASE_URL=http://192.168.11.25/llm/v1 등으로 핫스왑

# --- 인증(RBAC) — secure-by-default: 토큰 없으면 CLOSED ---
ADMIN_TOKEN=
USER_TOKEN=
INSECURE_OPEN_MODE=false

# --- 저장/RAG ---
DATA_DIR=./data
RAG_CHUNK_CHARS=1200
RAG_TOP_K=5
