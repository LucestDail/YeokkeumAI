# --- 서버 ---
SERVER_PORT=8080

# --- LLM 게이트웨이 (벤더무관; OpenAI 호환 엔드포인트면 무엇이든) ---
LLM_PROVIDER=auto                     # auto|openai_compat|stub
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=deepseek/deepseek-chat
LLM_API_KEY=
# 예) 사내 게이트웨이/국산 K-AI: LLM_BASE_URL=http://192.168.11.25/llm/v1

# --- 인증(RBAC) secure-by-default: 토큰 없으면 CLOSED ---
ADMIN_TOKEN=
USER_TOKEN=
INSECURE_OPEN_MODE=false

# --- DB (기본 H2 인메모리; 온프렘 영속=PostgreSQL) ---
DB_URL=jdbc:h2:mem:ieum;DB_CLOSE_DELAY=-1
DB_USER=sa
DB_PASSWORD=

# --- RAG ---
RAG_CHUNK_CHARS=1200
RAG_TOP_K=5
